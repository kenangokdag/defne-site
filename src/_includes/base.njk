<!doctype html>
<html lang="tr" data-arama="{{ '/arama.json' | url }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} | {% endif %}{{ site.kisaUnvan }} {{ site.ad }}</title>
<meta name="description" content="{{ ozet or site.aciklama }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:locale" content="tr_TR">
<meta property="og:site_name" content="{{ site.kisaUnvan }} {{ site.ad }}">
<meta property="og:title" content="{{ title or site.ad }}">
<meta property="og:description" content="{{ ozet or site.aciklama }}">
<meta name="theme-color" content="#3B2433">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/bodoni-moda-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/jost-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/style.css">
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="Blog">
<meta property="og:image" content="{{ site.url }}{{ kapak or '/assets/img/paylasim.png' }}">
<meta name="twitter:card" content="summary_large_image">

</head>
<body class="{{ bodyClass }}">
<a class="atla" href="#icerik">İçeriğe geç</a>
<header class="ust">
  <div class="kap ust__ic">
    <a class="logo" href="/" aria-label="Ana sayfa">
      <span class="logo__ad">{{ site.ad }}</span>
      <span class="logo__unvan">{{ site.unvan }}</span>
    </a>
    <button class="menu-dugme" aria-expanded="false" aria-controls="ana-menu">Menü</button>
    <nav id="ana-menu" class="menu" aria-label="Ana menü">
      {% set menu = [["/hakkimda/","Hakkımda"],["/hizmetler/","Hizmetler"],["/blog/","Blog"],["/tarifler/","Tarifler"],["/sss/","Sık sorulanlar"]] %}
      {% for m in menu %}<a href="{{ m[0] }}" {% if page.url.startsWith(m[0]) %}aria-current="page"{% endif %}>{{ m[1] }}</a>{% endfor %}
      <a class="menu__randevu" href="/randevu/">Randevu</a>
    </nav>
  </div>
</header>

<main id="icerik">
{{ content | safe }}
</main>

<footer class="alt">
  <div class="kap alt__ic">
    <div class="alt__marka">
      <p class="alt__ad">{{ site.kisaUnvan }} {{ site.ad }}</p>
      <p>{{ site.unvan }}</p>
      <p class="alt__not">Bu sitedeki içerikler bilgilendirme amaçlıdır; kişisel sağlık değerlendirmesinin yerine geçmez.</p>
    </div>
    <div>
      <p class="alt__baslik">İletişim</p>
      <p><a href="tel:{{ site.telefon | tel }}">{{ site.telefon }}</a><br>
      <a href="mailto:{{ site.eposta }}">{{ site.eposta }}</a><br>
      <a href="{{ site.haritaLinki }}" rel="noopener" target="_blank">{{ site.adres }}</a></p>
      <p>{{ site.calismaSaatleri }}</p>
    </div>
    <div>
      <p class="alt__baslik">Sayfalar</p>
      <p class="alt__linkler"><a href="/blog/">Blog</a><a href="/tarifler/">Tarifler</a><a href="/sss/">Sık sorulanlar</a><a href="/randevu/">Randevu</a><a href="/kvkk/">KVKK aydınlatma metni</a><a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram</a></p>
    </div>
  </div>
  <div class="kap alt__telif">© {% year %} {{ site.ad }}</div>
</footer>

<a class="wa" href="https://wa.me/{{ site.whatsapp }}?text={{ site.whatsappMesaj | urlenc }}" rel="noopener" target="_blank" aria-label="WhatsApp ile yazın">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1.1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
  <span>WhatsApp</span>
</a>
<script src="/assets/js/site.js" defer></script>
</body>
</html>
