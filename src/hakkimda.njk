---
layout: base.njk
title: Hakkımda
ozet: Diyetisyen ve hemşire Defne Duru Yılmaz'ın eğitimi, çalışma yaklaşımı ve akademik çalışmaları.
---
<section class="sayfa-bas kap hakkimda-bas">
  <div>
    <h1>Hakkımda</h1>
    <p class="sayfa-bas__giris">Hemşirelikten gelen klinik deneyimi, beslenme danışmanlığıyla birleştiriyorum.</p>
  </div>
  <div class="kemer kemer--kucuk">{% if site.portre %}<img src="{{ site.portre }}" alt="{{ site.ad }}">{% else %}{% include "incir.njk" %}{% endif %}</div>
</section>
<section class="kap-dar metin hakkimda-metin">
  {% for p in site.hakkimda %}<p>{{ p }}</p>{% endfor %}
</section>
<section class="bolum kap iki-sutun">
  <div>
    <h2 class="bolum__baslik">Eğitim</h2>
    <ul class="zaman">
      {% for e in site.egitim %}<li><span class="zaman__yil">{{ e.yil }}</span><div><h3>{{ e.baslik }}</h3><p>{{ e.kurum }}</p></div></li>{% endfor %}
    </ul>
  </div>
  <div>
    <h2 class="bolum__baslik">Akademik çalışmalar</h2>
    <ul class="zaman zaman--sade">
      {% for a in site.akademik %}<li><div><h3>{{ a.baslik }}</h3><p>{{ a.detay }}</p></div></li>{% endfor %}
    </ul>
  </div>
</section>
{% include "iletisim-bant.njk" %}
